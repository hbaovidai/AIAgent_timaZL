# App & Server Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=5173

# Database (SQLite Async)
DATABASE_URL=sqlite+aiosqlite:///./agent.db

# LLM Configuration (Mock for offline demo, or openai/gemini/openrouter)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Owner / Boss Configuration
OWNER_NAME=Chủ nhân
OWNER_ZALO_ID=owner_zalo_id_example
OWNER_PHONE=0901234567

# ZaloCRM Gateway Settings (Personal Zalo Account Manager)
ZALOCRM_BASE_URL=http://localhost:3000
ZALOCRM_API_KEY=your_zalocrm_api_key
ZALOCRM_WEBHOOK_SECRET=your_zalocrm_webhook_secret
ZALOCRM_DEFAULT_ACCOUNT_ID=zalo_account_default

# Agent Limits
MAX_AGENT_ITERATIONS=8
SHORT_TERM_MEMORY_LIMIT=20
